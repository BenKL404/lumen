# Paquet AUR de Lumen, construit depuis la branche principale du dépôt GitHub.
# Publication : copier PKGBUILD et .SRCINFO dans le dépôt AUR « lumen-player-git ».
# Maintainer: Kokou Bernard KPEDZI <167539412+BenKL404@users.noreply.github.com>
pkgname=lumen-player-git
_pkgname=lumen
pkgver=1.0.1
pkgrel=1
pkgdesc="Lecteur vidéo moderne pour Linux, inspiré de PotPlayer (Qt 6, libmpv)"
arch=('x86_64' 'aarch64')
url="https://github.com/BenKL404/lumen"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'mpv' 'ffmpeg' 'hicolor-icon-theme')
makedepends=('cargo' 'git')
optdepends=('yt-dlp: vidéos en ligne (YouTube…)'
            'deno: moteur JavaScript utilisé par yt-dlp pour YouTube'
            'xdg-desktop-portal: sélecteur de fichiers du bureau')
provides=('lumen-player')
conflicts=('lumen-player')
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    # 1.0.0.r12.gabc1234 : version de Cargo.toml + commits depuis
    local version
    version=$(grep -m1 '^version' Cargo.toml | cut -d'"' -f2)
    printf "%s.r%s.g%s" "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
    cd "$_pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "$_pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --release
}

package() {
    cd "$_pkgname"
    install -Dm755 target/release/lumen "$pkgdir/usr/bin/lumen"
    install -Dm644 assets/lumen.desktop "$pkgdir/usr/share/applications/lumen.desktop"
    install -Dm644 assets/icons/hicolor/scalable/apps/lumen.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/lumen.svg"
    for size in 16 24 32 48 64 128 256 512; do
        install -Dm644 "assets/icons/hicolor/${size}x${size}/apps/lumen.png" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/lumen.png"
    done
    # Fiche AppStream : le .desktop installé ici s'appelle lumen.desktop
    sed 's|<launchable type="desktop-id">.*</launchable>|<launchable type="desktop-id">lumen.desktop</launchable>|' \
        assets/io.github.benkl404.Lumen.metainfo.xml \
        | install -Dm644 /dev/stdin "$pkgdir/usr/share/metainfo/io.github.benkl404.Lumen.metainfo.xml"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
